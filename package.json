{
  "name": "rgb-impertintas-ai-altis-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "sync": "tsx scripts/pull-altis.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:push": "tsx scripts/push-altis.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}